{
  "$schema": "https://railway.app/railpack.schema.json",
  "build": {
    "steps": {
      "install": {
        "commands": [
          "python -m venv /app/.venv",
          "pip install -r requirements.txt"
        ]
      },
      "build": {
        "commands": []
      }
    }
  },
  "deploy": {
    "startCommand": "gunicorn --bind 0.0.0.0:$PORT league_tracker.app:app --workers 4 --threads 4 --timeout 120"
  }
}
